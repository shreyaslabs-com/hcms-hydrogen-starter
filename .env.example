# Worker environment. Copy to `.env` and fill in. The Hydrogen CLI loads `.env`
# into the Oxygen worker environment for `pnpm dev` / `pnpm preview`; on Oxygen a
# linked storefront injects these automatically.
#
# Mode is auto-detected: with a PRIVATE_STOREFRONT_API_TOKEN present the app talks
# to the real store; with none it falls back to the tokenless mock.shop demo (so a
# fresh deploy always renders). Set MOCK_SHOP=1 to force the mock explicitly.

# Force the tokenless mock.shop demo (also the default when no token is set).
# MOCK_SHOP=1
#
# mock.shop is many stores, each on its own host. In mock mode, set
# PUBLIC_STORE_DOMAIN to one of the hosts listed at https://mock.shop/llms.txt
# (for example pets.mock.shop) to build against that store's catalog instead of
# the default apparel store at mock.shop.

# Real store. Prefer pulling these from a linked Hydrogen storefront:
#   npx shopify hydrogen link && npx shopify hydrogen env pull
# On Oxygen, a linked storefront injects them for you. To set them by hand,
# PUBLIC_STORE_DOMAIN + PRIVATE_STOREFRONT_API_TOKEN connect to the store;
# PUBLIC_STOREFRONT_ID is optional and turns on Shopify Analytics.
PUBLIC_STORE_DOMAIN=
PUBLIC_STOREFRONT_ID=
PRIVATE_STOREFRONT_API_TOKEN=

# Customer Accounts (real store only, over HTTPS: `npm run dev:https`). Set all
# three to enable `/account`. On Oxygen, a linked storefront injects these for you.
# SESSION_SECRET signs the session cookie; use at least 32 random characters.
SHOP_ID=
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
SESSION_SECRET=

# HCMS. Set during onboarding (the admin shows the values).
# HCMS_PREVIEW_SECRET signs editor preview tokens and newsletter/contact forwards;
# HCMS_API_URL is the HCMS admin the forms forward to. Unset = previews off, forms 503.
HCMS_PREVIEW_SECRET=
HCMS_API_URL=
HCMS_PUBLIC_KEY=
# With a real store and none of the three above set, every page shows an
# "Install HCMS" setup screen (/__hcms/* still answers). Its button links here.
# HCMS_INSTALL_URL=

# Delivery check block, provider "Shiprocket serviceability" (optional; server-side only, never sent
# to the browser). Use a dedicated Shiprocket API user (Settings > API). Pickup = your dispatch pincode.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_PINCODE=
# Parcel weight in kg (default 0.5).
# SHIPROCKET_WEIGHT_KG=0.5
